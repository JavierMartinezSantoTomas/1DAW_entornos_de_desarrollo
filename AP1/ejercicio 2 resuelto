
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Ejercicio 2 - Arrays</title>
</head>
<body>
    <h1>Recorrer un array</h1>

    <script>
        let numeros = [1, 2, 9, 1, 2];
        let suma = 0;
        let maximo = numeros[0];

        for (let i = 0; i < numeros.length; i++) {
            suma = suma + numeros[i];

            if (numeros[i] > maximo) {
                maximo = numeros[i];
            }

            console.log("Número:", numeros[i]);
            console.log("Suma:", suma);
            console.log("Máximo:", maximo);
        }

        let media = suma / numeros.length;

        console.log("Suma final:", suma);
        console.log("Máximo:", maximo);
        console.log("Media:", media);

        let negativos = [-5, -3, -8, -2];
        let maxNegativo = negativos[0];

        for (let i = 0; i < negativos.length; i++) {
            if (negativos[i] > maxNegativo) {
                maxNegativo = negativos[i];
            }
        }

        console.log("Máximo con negativos:", maxNegativo);
    </script>
</body>
</html>
